# Copy to .env.local to override. Every value here is a public URL; this app has no secrets.

# Where the Swarm ID identity frame and sign-in window live.
VITE_SWARM_ID_ORIGIN=https://swarm-id.snaha.net

# The upload route for users who hold no postage stamp. The public gateway stamps
# their uploads with its own batch. Note the "api." host: gateway.ethswarm.org is the website.
# Set it to an empty value to see what a first-time user gets without it (NO_DRIVE).
VITE_SUBSIDISED_GATEWAY_URL=https://api.gateway.ethswarm.org/

# Default address for the optional "my own Bee node" route (Swarm Desktop).
VITE_LOCAL_BEE_URL=http://localhost:1633

# Where the independent reader (apps/reader) is served, for "Open in Almanac" links.
VITE_READER_URL=http://localhost:5174
